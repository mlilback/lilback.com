$ORIGIN lilback.com.
$TTL 300

; ---- Fastmail (inbound) ----
@	300	IN	MX	10 in1-smtp.messagingengine.com.
@	300	IN	MX	20 in2-smtp.messagingengine.com.
@	300	IN	TXT	"v=spf1 include:spf.messagingengine.com ?all"
mail	300	IN	CNAME	in1-smtp.messagingengine.com.

; ---- Fastmail DKIM ----
fm1._domainkey		300	IN	CNAME	fm1.lilback.com.dkim.fmhosted.com.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lilback-com",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "observability": { "enabled": true },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "analytics_engine_datasets": [
    { "binding": "HITS", "dataset": "blog_hits" }
  ]
}
